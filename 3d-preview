<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cricket Activity Studio — 3D Views Prototype</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;color:#eaf1f7;background:#0c1520}*{box-sizing:border-box}body{margin:0}.app{max-width:1440px;margin:auto;padding:20px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:15px}.eyebrow{font-size:11px;letter-spacing:1.6px;color:#87a7c4;font-weight:800}.top h1{font-size:23px;margin:5px 0 0}.chip{font-size:12px;border:1px solid #33506a;border-radius:20px;padding:8px 12px;color:#a9c3d8}.layout{display:grid;grid-template-columns:minmax(0,1fr) 285px;gap:16px}.panel{background:#142231;border:1px solid #2b4257;border-radius:16px;overflow:hidden}.toolbar{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:13px;border-bottom:1px solid #2b4257}.seg{display:flex;gap:3px;background:#0b1723;padding:4px;border-radius:10px}.seg button{border:0;background:transparent;color:#aac0d3;border-radius:7px;padding:9px 12px;font-weight:650;cursor:pointer}.seg button.active{background:#3478e7;color:white}button,select,input{font:inherit}button{cursor:pointer}.select{margin-left:auto;background:#0b1723;color:#eaf1f7;border:1px solid #3b546c;padding:10px;border-radius:9px}#stage{display:block;width:100%;height:min(60vw,560px);min-height:350px;touch-action:none;cursor:grab;background:#a5cfe0}#stage:active{cursor:grabbing}.stagewrap{position:relative}.overlay{position:absolute;top:14px;left:15px;pointer-events:none;background:#0c1c2dcc;color:#e9f4ff;padding:8px 11px;border-radius:8px;font-size:12px}.tip{position:absolute;bottom:12px;left:12px;background:#0c1c2dcc;color:#e9f4ff;padding:8px 11px;border-radius:8px;font-size:12px;pointer-events:none}.playback{padding:14px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}.primary{background:#3478e7;color:white;border:0;border-radius:9px;padding:10px 18px;font-weight:700}.secondary{background:#243b50;border:1px solid #3b566f;color:#e9f2f9;border-radius:9px;padding:9px 13px}.timeline{flex:1;min-width:140px;accent-color:#63a6ff}.time{font-size:12px;color:#b4c7d7;min-width:65px}.side{padding:18px}.side h2{font-size:16px;margin:0 0 8px}.side p{font-size:13px;line-height:1.6;color:#b0c3d3}.field{margin-top:18px}.field label{font-size:12px;color:#c4d4e1;display:block;margin-bottom:8px}.field input{width:100%;accent-color:#5fa5ff}.field select{width:100%;background:#0b1723;color:white;border:1px solid #3b546c;border-radius:9px;padding:10px}.mini{margin-top:18px;border-top:1px solid #2c455b;padding-top:14px}.mini strong{font-size:13px}.mini p{margin:5px 0 0}.legend{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:#b7cbda;margin-top:12px}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}.footer{font-size:12px;color:#91abc0;margin:15px 2px;line-height:1.6}@media(max-width:850px){.layout{grid-template-columns:1fr}.select{margin-left:0}#stage{height:440px}.app{padding:12px}.top h1{font-size:19px}} </style></head><body><div class="app"><header class="top"><div><div class="eyebrow">CRICKET ACTIVITY STUDIO · INTERACTIVE CONCEPT</div><h1>One drill. Three ways to see it.</h1></div><span class="chip">Browser-rendered · No Supabase · $0 libraries</span></header><div class="layout"><main class="panel"><div class="toolbar"><div class="seg" role="group" aria-label="Viewing mode"><button data-mode="top">Bird's-eye</button><button data-mode="angled" class="active">Angled 3D</button><button data-mode="coach">Coach View</button></div><select id="coach" class="select" aria-label="Coach viewpoint"><option value="0">Coach 1</option><option value="1">Coach 2</option></select></div><div class="stagewrap"><canvas id="stage"></canvas><div id="viewLabel" class="overlay">ANGLED VIEW · Complete drill</div><div id="tip" class="tip">Drag to orbit · Scroll to zoom</div></div><div class="playback"><button id="play" class="primary">▶ Play</button><button id="reset" class="secondary">↺ Reset</button><input id="timeline" class="timeline" type="range" min="0" max="1000" value="0" aria-label="Animation progress"><span id="time" class="time">0.0 / 16s</span><select id="speed" class="select" aria-label="Playback speed"><option value="0.5">0.5×</option><option value="1" selected>1×</option><option value="1.5">1.5×</option><option value="2">2×</option></select></div></main><aside class="panel side"><h2>Explore the drill</h2><p>Watch the same fielding sequence from overhead, an elevated 3D angle, or directly through a coach's eyes.</p><div class="field"><label for="height">Coach eye height: <strong id="heightLabel">1.9 m</strong></label><input id="height" type="range" min="1.5" max="2.4" value="1.9" step="0.1"></div><div class="field"><label for="fov">Camera field of view: <strong id="fovLabel">75°</strong></label><input id="fov" type="range" min="50" max="95" value="75" step="1"></div><div class="field"><label for="ballMode">Delivery sequence (demo only)</label><select id="ballMode"><option value="mixed">Mixed — ground, low, high</option><option value="ground">All ground</option><option value="low">All low throws</option><option value="high">All high throws</option></select></div><div class="mini"><strong>What to look for</strong><p>Cones stay on the turf. Distant players get smaller. Ball height changes naturally. Switching coaches changes where the camera stands.</p></div><div class="legend"><span><i class="dot" style="background:#f5bd43"></i>Players</span><span><i class="dot" style="background:#eaf4ff"></i>Coaches</span><span><i class="dot" style="background:#ff944f"></i>Cones</span><span><i class="dot" style="background:#fff266"></i>Ball</span></div></aside></div><p class="footer">Standalone proof of concept. Uses a small dependency-free 3D projection engine and illustrative player models; no paid APIs, database calls or uploaded assets. A production version would connect these views to your existing saved activity data and Admin-selected ball deliveries.</p></div><script>
(()=>{'use strict';
const canvas=document.getElementById('stage'),ctx=canvas.getContext('2d');let W=900,H=560,dpr=1,mode='angled',coachIdx=0,eye=1.9,fov=75,az=0.7,elev=.57,dist=24,playing=false,t=0,last=0,drag=null;
const coaches=[{x:0,z:9,heading:0},{x:8,z:-2,heading:-1.6}],players=[{id:1,x:-6,z:-3},{id:2,x:6,z:-5},{id:3,x:-4,z:5},{id:4,x:4,z:4}],cones=[[-8,-7],[0,-7],[8,-7],[-8,7],[0,7],[8,7]],stumps=[{x:0,z:-10},{x:0,z:10}];
const V=(x,y,z)=>({x,y,z}),lerp=(a,b,k)=>a+(b-a)*k,clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function resize(){const r=canvas.getBoundingClientRect();dpr=Math.min(devicePixelRatio||1,2);W=r.width;H=r.height;canvas.width=Math.round(W*dpr);canvas.height=Math.round(H*dpr);ctx.setTransform(dpr,0,0,dpr,0,0)}new ResizeObserver(resize).observe(canvas);resize();
function camera(){if(mode==='top')return {p:V(0,36,.01),target:V(0,0,0),up:V(0,0,-1),orth:true};if(mode==='angled')return{p:V(Math.sin(az)*Math.cos(elev)*dist,Math.sin(elev)*dist+3,Math.cos(az)*Math.cos(elev)*dist),target:V(0,0,0),up:V(0,1,0)};const c=coaches[coachIdx];return{p:V(c.x,eye,c.z),target:V(c.x+Math.sin(az),eye+Math.tan(elev),c.z-Math.cos(az)),up:V(0,1,0)}}
const sub=(a,b)=>V(a.x-b.x,a.y-b.y,a.z-b.z),dot=(a,b)=>a.x*b.x+a.y*b.y+a.z*b.z,cross=(a,b)=>V(a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x),norm=a=>{let l=Math.hypot(a.x,a.y,a.z)||1;return V(a.x/l,a.y/l,a.z/l)};
function projector(){const c=camera(),forward=norm(sub(c.target,c.p)),right=norm(cross(forward,c.up)),up=norm(cross(right,forward)),scale=H/(2*Math.tan(fov*Math.PI/360));return p=>{let v=sub(p,c.p),depth=dot(v,forward);if(mode==='top')return {x:W/2+p.x*Math.min(W/26,H/26),y:H/2+p.z*Math.min(W/26,H/26),depth:50,visible:true,s:Math.min(W/26,H/26)};return {x:W/2+dot(v,right)*scale/Math.max(depth,.1),y:H/2-dot(v,up)*scale/Math.max(depth,.1),depth,visible:depth>.18,s:scale/Math.max(depth,.1)}}}
function poly(points,color,stroke,width=1){if(points.some(p=>!p.visible))return;ctx.beginPath();ctx.moveTo(points[0].x,points[0].y);for(let i=1;i<points.length;i++)ctx.lineTo(points[i].x,points[i].y);ctx.closePath();ctx.fillStyle=color;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=width;ctx.stroke()}}
function line(points,color,width=1,dash=[]){if(points.some(p=>!p.visible))return;ctx.beginPath();ctx.moveTo(points[0].x,points[0].y);for(let i=1;i<points.length;i++)ctx.lineTo(points[i].x,points[i].y);ctx.strokeStyle=color;ctx.lineWidth=width;ctx.setLineDash(dash);ctx.stroke();ctx.setLineDash([])}
function circle(p,r,color,stroke){if(!p.visible||p.x< -500||p.x>W+500||p.y< -500||p.y>H+500)return;ctx.beginPath();ctx.arc(p.x,p.y,Math.max(.5,r),0,Math.PI*2);ctx.fillStyle=color;ctx.fill();if(stroke){ctx.lineWidth=1.3;ctx.strokeStyle=stroke;ctx.stroke()}}
function playerPosition(i,time){let p=players[i],dx=0,dz=0;if(time>4&&time<12){let k=Math.sin((time-4)/8*Math.PI);if(i===0){dx=1.7*k;dz=1.2*k}if(i===1){dx=-2*k;dz=1.4*k}if(i===2){dx=1*k;dz=-1.4*k}if(i===3){dx=-1.2*k;dz=-1.8*k}}return V(p.x+dx,0,p.z+dz)}
function delivery(i){const v=document.getElementById('ballMode').value;return v==='mixed'?['ground','low','high'][i]:v}
function ballPosition(time){let k=Math.min(2,Math.floor(time/5.33)),u=clamp((time-k*5.33)/4.4,0,1);const targets=[playerPosition(0,time),playerPosition(1,time),playerPosition(3,time)],origins=[V(coaches[0].x,0,coaches[0].z),targets[0],targets[1]];const a=origins[k],b=targets[k];let h=delivery(k)==='high'?5.8:delivery(k)==='low'?1.9:.16;return V(lerp(a.x,b.x,u),delivery(k)==='ground'?.14:1.05+4*h*u*(1-u),lerp(a.z,b.z,u))}
function drawGround(P){const sky=ctx.createLinearGradient(0,0,0,H);sky.addColorStop(0,'#91c8e9');sky.addColorStop(.7,'#d7ebf1');sky.addColorStop(1,'#e3f1f2');ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);poly([P(V(-100,0,-100)),P(V(100,0,-100)),P(V(100,0,100)),P(V(-100,0,100))],'#398759');for(let z=-80;z<=80;z+=4)line([P(V(-90,.012,z)),P(V(90,.012,z))],z%8===0?'#ffffff22':'#0d4c2a33',1);for(let x=-80;x<=80;x+=4)line([P(V(x,.012,-90)),P(V(x,.012,90))],x%8===0?'#ffffff18':'#0d4c2a33',1);poly([P(V(-10,.018,-12)),P(V(10,.018,-12)),P(V(10,.018,12)),P(V(-10,.018,12))],'#66a87633','#c5e1bd55');poly([P(V(-1.6,.023,-10)),P(V(1.6,.023,-10)),P(V(1.6,.023,10)),P(V(-1.6,.023,10))],'#c8b58a','#e5d3a8');line([P(V(-10,.04,-10)),P(V(10,.04,-10))],'#f6f7e8',1.6);line([P(V(-10,.04,10)),P(V(10,.04,10))],'#f6f7e8',1.6)}
function drawPerson(P,pos,id,isCoach){let base=P(V(pos.x,0,pos.z));if(!base.visible)return;let head=P(V(pos.x,1.75,pos.z)),neck=P(V(pos.x,1.48,pos.z)),hip=P(V(pos.x,.8,pos.z)),lfoot=P(V(pos.x-.18,.06,pos.z)),rfoot=P(V(pos.x+.18,.06,pos.z)),larm=P(V(pos.x-.38,1.02,pos.z)),rarm=P(V(pos.x+.38,1.02,pos.z));let w=clamp(head.s*.14,2,18);circle(P(V(pos.x,.03,pos.z)),clamp(base.s*.36,3,35),'#183e2c88');line([hip,lfoot],'#203d5a',w*.85);line([hip,rfoot],'#203d5a',w*.85);line([neck,hip],isCoach?'#e5edf6':'#f6c346',w*2.2);line([neck,larm],isCoach?'#e5edf6':'#f6c346',w*.7);line([neck,rarm],isCoach?'#e5edf6':'#f6c346',w*.7);circle(head,w*.75,'#edbf95','#ae835f');if(head.s>5){ctx.fillStyle=isCoach?'#0f3550':'#172e3b';ctx.textAlign='center';ctx.font=`bold ${clamp(head.s*.22,9,18)}px system-ui`;ctx.fillText(isCoach?'C'+id:String(id),neck.x,lerp(neck.y,hip.y,.5)+3)}}
function drawCone(P,x,z){let base=P(V(x,0,z)),peak=P(V(x,.52,z)),l=P(V(x-.23,.01,z)),r=P(V(x+.23,.01,z));poly([l,peak,r],'#ff8a3c','#ffefc6',1.2);line([l,r],'#fff0d5',1.5)}
function drawStumps(P,x,z){for(let dx of [-.15,0,.15])line([P(V(x+dx,0,z)),P(V(x+dx,.75,z))],'#f9f5df',clamp(P(V(x,0,z)).s*.045,1,5));line([P(V(x-.2,.76,z)),P(V(x+.2,.76,z))],'#f9f5df',2)}
function draw(){if(!W||!H)return;const P=projector();drawGround(P);let objs=[];for(const [x,z] of cones)objs.push({depth:P(V(x,0,z)).depth,draw:()=>drawCone(P,x,z)});for(const s of stumps)objs.push({depth:P(V(s.x,0,s.z)).depth,draw:()=>drawStumps(P,s.x,s.z)});players.forEach((_,i)=>{const p=playerPosition(i,t);objs.push({depth:P(p).depth,draw:()=>drawPerson(P,p,i+1,false)})});coaches.forEach((c,i)=>{if(mode==='coach'&&coachIdx===i)return;const p=V(c.x,0,c.z);objs.push({depth:P(p).depth,draw:()=>drawPerson(P,p,i+1,true)})});objs.sort((a,b)=>b.depth-a.depth);objs.forEach(o=>o.draw());let b=ballPosition(t);circle(P(b),clamp(P(b).s*.12,3,12),'#fff05e','#7d6d14');circle(P(V(b.x,.02,b.z)),clamp(P(b).s*.12,2,9),'#163e2755');if(mode!=='coach'){let pts=[];for(let u=0;u<=20;u++){let tt=clamp(t-.7+u*.035,0,16);pts.push(P(ballPosition(tt)))}for(let i=1;i<pts.length;i++)line([pts[i-1],pts[i]],'#ffe364bb',2)}requestAnimationFrame(()=>{})}
function setMode(v){mode=v;document.querySelectorAll('[data-mode]').forEach(b=>b.classList.toggle('active',b.dataset.mode===v));document.getElementById('coach').disabled=v!=='coach';if(v==='top'){az=0;elev=0}else if(v==='angled'){az=.7;elev=.57;dist=24}else{az=coaches[coachIdx].heading;elev=-.06}document.getElementById('viewLabel').textContent=v==='top'?'BIRD’S-EYE · Layout & positions':v==='angled'?'ANGLED 3D · Understand the setup':`COACH VIEW · Coach ${coachIdx+1} · First-person`;document.getElementById('tip').textContent=v==='top'?'Top-down layout':v==='angled'?'Drag to orbit · Scroll to zoom':'Drag to turn · Look slightly up/down';draw()}
for(const b of document.querySelectorAll('[data-mode]'))b.addEventListener('click',()=>setMode(b.dataset.mode));document.getElementById('coach').addEventListener('change',e=>{coachIdx=+e.target.value;setMode(mode)});document.getElementById('height').addEventListener('input',e=>{eye=+e.target.value;document.getElementById('heightLabel').textContent=eye.toFixed(1)+' m';draw()});document.getElementById('fov').addEventListener('input',e=>{fov=+e.target.value;document.getElementById('fovLabel').textContent=fov+'°';draw()});document.getElementById('ballMode').addEventListener('change',draw);
canvas.addEventListener('pointerdown',e=>{drag={x:e.clientX,y:e.clientY,az,elev};canvas.setPointerCapture(e.pointerId)});canvas.addEventListener('pointermove',e=>{if(!drag||mode==='top')return;az=drag.az-(e.clientX-drag.x)*.006;elev=clamp(drag.elev+(e.clientY-drag.y)*.004,mode==='coach'?-.38:.16,mode==='coach'?.25:1.25);draw()});canvas.addEventListener('pointerup',()=>drag=null);canvas.addEventListener('pointercancel',()=>drag=null);canvas.addEventListener('wheel',e=>{if(mode!=='angled')return;e.preventDefault();dist=clamp(dist+e.deltaY*.025,12,50);draw()},{passive:false});
const play=document.getElementById('play'),timeline=document.getElementById('timeline');play.addEventListener('click',()=>{if(t>=16)t=0;playing=!playing;play.textContent=playing?'Ⅱ Pause':'▶ Play';last=performance.now()});document.getElementById('reset').addEventListener('click',()=>{playing=false;t=0;play.textContent='▶ Play';sync();draw()});timeline.addEventListener('input',e=>{t=+e.target.value/1000*16;sync();draw()});function sync(){timeline.value=Math.round(t/16*1000);document.getElementById('time').textContent=t.toFixed(1)+' / 16s'}function tick(now){let dt=Math.min((now-last)/1000,.08);last=now;if(playing){t+=dt*(+document.getElementById('speed').value);if(t>=16){t=16;playing=false;play.textContent='▶ Play'}sync()}draw();requestAnimationFrame(tick)}setMode('angled');requestAnimationFrame(tick);
})();
</script></body></html>
